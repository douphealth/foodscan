{
  // Optional reference configuration for a Git-connected Cloudflare deployment.
  // Direct Upload users can configure equivalent bindings in the dashboard.
  "name": "foodscan",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "foodscan_events" }
  ],
  "ratelimits": [
    {
      "name": "UPSTREAM_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
}
